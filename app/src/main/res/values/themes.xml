<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Calc" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/btn_operator_bg</item>
        <item name="colorPrimaryVariant">@color/btn_operator_ripple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/btn_equals_bg</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <!-- Base button style -->
    <style name="CalcButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_margin">5dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Digit button -->
    <style name="CalcButton.Digit" parent="CalcButton">
        <item name="backgroundTint">@color/btn_digit_bg</item>
        <item name="android:textColor">@color/btn_digit_text</item>
        <item name="rippleColor">@color/btn_digit_ripple</item>
    </style>

    <!-- Operator button -->
    <style name="CalcButton.Operator" parent="CalcButton">
        <item name="backgroundTint">@color/btn_operator_bg</item>
        <item name="android:textColor">@color/btn_operator_text</item>
        <item name="android:textSize">26sp</item>
        <item name="rippleColor">@color/btn_operator_ripple</item>
    </style>

    <!-- Function button (log, ln, DEL, C) -->
    <style name="CalcButton.Function" parent="CalcButton">
        <item name="backgroundTint">@color/btn_function_bg</item>
        <item name="android:textColor">@color/btn_function_text</item>
        <item name="android:textSize">18sp</item>
        <item name="rippleColor">@color/btn_function_ripple</item>
    </style>

    <!-- Equals button -->
    <style name="CalcButton.Equals" parent="CalcButton">
        <item name="backgroundTint">@color/btn_equals_bg</item>
        <item name="android:textColor">@color/btn_equals_text</item>
        <item name="android:textSize">26sp</item>
        <item name="rippleColor">@color/btn_equals_ripple</item>
    </style>

</resources>
